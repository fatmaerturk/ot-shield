# OTShield production environment. Copy this to ".env" NEXT TO docker-compose.yml
# on the VM, fill the two GENERATE-ME values, then `docker compose up -d`.
# NEVER commit the real .env (it is git-ignored).

# --- Database (internal to the compose network) ---
DB_NAME=otshield_db
DB_USERNAME=otshield
# GENERATE-ME: a strong DB password, e.g.  openssl rand -base64 24
DB_PASSWORD=CHANGE_ME_db_password

# --- Backend secrets ---
# GENERATE-ME: a long random JWT signing secret, e.g.  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_jwt_secret

# Bearer token the Conpot forwarder uses to POST /api/honeypot/ingest.
# Kept the same as the current dev token so the honeypot forwarder keeps working
# after you just repoint its URL to this VM. Rotate later if you wish.
HONEYPOT_INGEST_TOKEN=GcZ9KY7ANmLfvob6SOWxnRBjVlEPX2uaMr805td4IHTCezyU

# --- Frontend build ---
# CARTO basemap key (already provisioned). Baked into the frontend at build time.
REACT_APP_CARTO_KEY=cb1_3jfj_1_ad6f1ae9160d0de9c8d5186b

# --- Public domains (Caddy fetches Let's Encrypt certs for these) ---
OTSHIELD_DOMAIN=soc.otshield.io
# Splunk web UI subdomain. Needs its own DNS A record -> the static IP.
SPLUNK_DOMAIN=splunk.otshield.io

# --- Splunk demo target ---
# Admin password for the Splunk web UI (user: admin). Min 8 chars.
SPLUNK_PASSWORD=CHANGE_ME_splunk_password
# HEC token the timeline re-sync uses. GENERATE-ME: a UUID, e.g.  uuidgen
SPLUNK_HEC_TOKEN=CHANGE_ME_hec_token_uuid
