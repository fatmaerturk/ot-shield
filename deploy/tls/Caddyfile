# Automatic HTTPS for OTShield. Caddy fetches/renews Let's Encrypt certs on its
# own and reverse-proxies to the frontend / Splunk containers.
#
# ACCESS RESTRICTED (2026-10-25) to the operator's ISP block 37.203.167.0/24.
# Everyone else gets 403. /api/honeypot/* stays open on the SOC host so the
# honeypot forwarder can keep ingesting (it is bearer-token protected). ACME
# challenges are served by Caddy on :80 / TLS-ALPN and are NOT affected by
# these HTTPS handlers, so certificate renewal keeps working.
# NOTE: if the operator's ISP block changes, update the remote_ip CIDR below.

{$OTSHIELD_DOMAIN} {
	encode zstd gzip
	@operator remote_ip 37.203.167.0/24
	handle /api/honeypot/* {
		reverse_proxy frontend:80
	}
	handle @operator {
		reverse_proxy frontend:80
	}
	handle {
		respond "Forbidden" 403
	}
}

{$SPLUNK_DOMAIN} {
	encode zstd gzip
	@operator remote_ip 37.203.167.0/24
	handle @operator {
		reverse_proxy splunk:8000
	}
	handle {
		respond "Forbidden" 403
	}
}
